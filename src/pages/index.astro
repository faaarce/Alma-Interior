---
// Astro page with Tailwind CSS
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alma Interior - Design & Build</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .font-serif { font-family: 'Cormorant Garamond', serif; }
    .font-sans { font-family: 'Inter', sans-serif; }
    
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }
    
    @keyframes gradient {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }
    
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
    
    .animate-gradient {
      background-size: 200% 200%;
      animation: gradient 8s ease infinite;
    }
    
    .glass-effect {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .text-shadow-gold {
      text-shadow: 0 2px 10px rgba(212, 175, 55, 0.3);
    }
    
    .hover-lift {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .hover-lift:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }
  </style>
</head>
<body class="font-sans bg-[#E8E4DC]">
<!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 glass-effect">
    <div class="container mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-2xl flex items-center justify-center cursor-pointer hover:scale-110 transition-transform">
            <span class="text-xl font-bold text-white font-serif">A</span>
          </div>
          <span class="text-white font-bold tracking-wider">ALMA INTERIOR</span>
        </div>
        
        <!-- Desktop Menu -->
        <div class="hidden lg:flex items-center gap-8">
          <a href="#home" class="text-white hover:text-[#D4AF37] transition-colors text-sm font-medium uppercase tracking-wider">Home</a>
          <a href="#why-us" class="text-white hover:text-[#D4AF37] transition-colors text-sm font-medium uppercase tracking-wider">Why Us</a>
          <a href="#projects" class="text-white hover:text-[#D4AF37] transition-colors text-sm font-medium uppercase tracking-wider">Projects</a>
          
          <!-- Portfolio Dropdown -->
          <div class="relative group">
            <button class="text-white hover:text-[#D4AF37] transition-colors text-sm font-medium uppercase tracking-wider flex items-center gap-1">
              Portfolio
              <svg class="w-4 h-4 group-hover:rotate-180 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <!-- Dropdown Menu -->
            <div class="absolute top-full left-0 mt-2 w-56 bg-white/95 backdrop-blur-lg rounded-2xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform group-hover:translate-y-0 translate-y-2">
              <div class="py-3">
                <a href="#wall-panel" class="block px-6 py-3 text-[#3A3A3A] hover:bg-gradient-to-r hover:from-[#D4AF37]/10 hover:to-[#C5A572]/10 hover:text-[#D4AF37] transition-all text-sm font-medium">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">🖼️</span>
                    <span>Wall Panel</span>
                  </div>
                </a>
                <a href="#kitchen-set" class="block px-6 py-3 text-[#3A3A3A] hover:bg-gradient-to-r hover:from-[#D4AF37]/10 hover:to-[#C5A572]/10 hover:text-[#D4AF37] transition-all text-sm font-medium">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">🍳</span>
                    <span>Kitchen Set</span>
                  </div>
                </a>
              </div>
            </div>
          </div>
          
          <a href="#services" class="text-white hover:text-[#D4AF37] transition-colors text-sm font-medium uppercase tracking-wider">Services</a>
          <a href="#reviews" class="text-white hover:text-[#D4AF37] transition-colors text-sm font-medium uppercase tracking-wider">Reviews</a>
        </div>
        
        <button class="px-6 py-2 bg-gradient-to-r from-[#D4AF37] to-[#C5A572] text-white rounded-full text-sm font-medium hover:shadow-lg transition-all hover:scale-105">
          <a href="#contact" class="block">Contact Us</a>
        </button>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#E8E4DC] via-[#F5F2EB] to-[#E8E4DC] animate-gradient">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-20 left-10 w-72 h-72 bg-[#C5A572] opacity-10 rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-[#D4AF37] opacity-10 rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>
      <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-[#C5A572] opacity-5 rounded-full blur-3xl animate-float" style="animation-delay: 4s;"></div>
    </div>

    <!-- Geometric Pattern Overlay -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle, #C5A572 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 container mx-auto px-6 text-center pt-20">
      <!-- Logo with Animation -->
      <div class="inline-flex items-center justify-center w-28 h-28 bg-gradient-to-br from-[#D4AF37] via-[#C5A572] to-[#B8963C] rounded-[2rem] mb-8 shadow-2xl hover:scale-110 transition-transform cursor-pointer border border-white/20 animate-float">
        <span class="text-5xl font-bold text-white font-serif text-shadow-gold">A</span>
      </div>

      <!-- Title with Enhanced Typography -->
      <h1 class="text-8xl md:text-9xl font-bold text-[#3A3A3A] mb-6 font-serif tracking-tight text-shadow-gold">
        ALMA<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] via-[#C5A572] to-[#D4AF37] animate-gradient">INTERIOR</span>
      </h1>
      
      <div class="inline-block mb-4">
        <p class="text-2xl text-[#6B6B6B] font-serif italic relative">
          DESIGN & BUILD
          <span class="absolute -bottom-2 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-[#C5A572] to-transparent"></span>
        </p>
      </div>

      <!-- Subtitle -->
      <p class="text-xl md:text-2xl text-[#5A5A5A] max-w-3xl mx-auto mb-16 leading-relaxed font-sans">
        Interior Design & Custom Furniture desain modern,<br/>
        <span class="text-[#C5A572] font-semibold">rapih sesuai kebutuhan anda.</span>
      </p>

      <!-- Enhanced CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center mb-24">
        <button class="group px-12 py-5 bg-gradient-to-r from-[#D4AF37] via-[#C5A572] to-[#D4AF37] text-white font-semibold rounded-full shadow-2xl hover:shadow-[#C5A572]/50 hover:scale-105 transition-all uppercase tracking-widest animate-gradient">
          <span class="flex items-center gap-3">
            Konsultasi Gratis
            <svg class="w-6 h-6 group-hover:translate-x-2 transition-transform" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </span>
        </button>
        
        <button class="group px-12 py-5 bg-white text-[#3A3A3A] font-semibold rounded-full border-2 border-[#C5A572] hover:bg-gradient-to-r hover:from-[#D4AF37] hover:to-[#C5A572] hover:text-white hover:border-transparent transition-all shadow-xl hover:scale-105 uppercase tracking-widest">
          <span class="flex items-center gap-3">
            <svg class="w-6 h-6 text-green-500 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            Hubungi Kami
          </span>
        </button>
      </div>
      
      <!-- Enhanced Scroll Indicator -->
      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 animate-bounce">
        <div class="flex flex-col items-center gap-2">
          <div class="w-8 h-12 border-2 border-[#C5A572] rounded-full flex items-start justify-center p-2">
            <div class="w-2 h-4 bg-gradient-to-b from-[#D4AF37] to-[#C5A572] rounded-full animate-pulse"></div>
          </div>
          <span class="text-xs text-[#C5A572] uppercase tracking-widest">Scroll</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-32 bg-gradient-to-br from-[#1C1C1C] via-[#2C2C2C] to-[#1C1C1C] text-white relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[#C5A572] to-transparent"></div>
    
    <!-- Animated Background -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-0 right-0 w-96 h-96 bg-[#D4AF37] rounded-full blur-3xl animate-float"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#C5A572] rounded-full blur-3xl animate-float" style="animation-delay: 3s;"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="grid lg:grid-cols-2 gap-20 items-center">
        <!-- Content Side -->
        <div>
          <div class="mb-6">
            <span class="text-[#C5A572] uppercase tracking-[0.3em] text-sm font-semibold">Excellence in Design</span>
          </div>
          
          <h2 class="text-7xl md:text-8xl font-bold mb-10 font-serif leading-tight">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] via-[#C5A572] to-[#D4AF37] animate-gradient">WHY</span>
            <br />
            ALMA<br/>
            <span class="text-[#E8E4DC]">INTERIOR?</span>
          </h2>
          
          <p class="text-[#D4D0C8] text-xl mb-12 leading-relaxed max-w-xl">
            Kami membantu mewujudkan ruang impian dengan desain modern, pengerjaan rapih dan material berkualitas. Setiap project kami kerjakan sesuai kebutuhan dan budget klien.
          </p>

          <!-- Enhanced Features List -->
          <div class="space-y-6">
            <div class="flex items-start gap-5 group hover:translate-x-3 transition-all cursor-pointer p-4 rounded-2xl hover:bg-white/5">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-2xl flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-1 group-hover:text-[#D4AF37] transition-colors">Desain Custom</h3>
                <p class="text-[#B0B0B0] text-sm">Sesuai keinginan dan kebutuhan Anda</p>
              </div>
            </div>
            
            <div class="flex items-start gap-5 group hover:translate-x-3 transition-all cursor-pointer p-4 rounded-2xl hover:bg-white/5">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-2xl flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-1 group-hover:text-[#D4AF37] transition-colors">Tepat Waktu</h3>
                <p class="text-[#B0B0B0] text-sm">Pengerjaan rapih dan sesuai deadline</p>
              </div>
            </div>
            
            <div class="flex items-start gap-5 group hover:translate-x-3 transition-all cursor-pointer p-4 rounded-2xl hover:bg-white/5">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-2xl flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-1 group-hover:text-[#D4AF37] transition-colors">Harga Transparan</h3>
                <p class="text-[#B0B0B0] text-sm">Tanpa biaya tersembunyi</p>
              </div>
            </div>
            
            <div class="flex items-start gap-5 group hover:translate-x-3 transition-all cursor-pointer p-4 rounded-2xl hover:bg-white/5">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-2xl flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-1 group-hover:text-[#D4AF37] transition-colors">Konsultasi Gratis</h3>
                <p class="text-[#B0B0B0] text-sm">Diskusi kebutuhan tanpa biaya</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Image Side with Enhanced Design -->
        <div class="relative group">
          <div class="absolute -inset-8 bg-gradient-to-r from-[#D4AF37] via-[#C5A572] to-[#D4AF37] rounded-[3rem] blur-3xl opacity-20 group-hover:opacity-30 transition-opacity animate-gradient"></div>
          <div class="relative overflow-hidden rounded-[2.5rem] shadow-2xl border border-white/10 hover-lift">
            <div class="aspect-[4/3] bg-gradient-to-br from-[#3A3A3A] via-[#4A4A4A] to-[#2C2C2C] flex items-center justify-center p-12">
              <div class="text-center">
                <div class="w-40 h-40 mx-auto bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-[2rem] flex items-center justify-center mb-6 border-2 border-white/20 shadow-2xl animate-float">
                  <span class="text-7xl">✨</span>
                </div>
                <h3 class="text-2xl font-serif text-[#D4AF37] mb-2">Luxury Interior</h3>
                <p class="text-[#B0B0B0] text-sm italic">Crafted with Excellence</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Projects Section -->
  <section class="py-32 bg-[#E8E4DC] relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-20 w-64 h-64 bg-[#C5A572] rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-20 w-96 h-96 bg-[#D4AF37] rounded-full blur-3xl"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-24">
        <span class="text-[#C5A572] uppercase tracking-[0.3em] text-sm font-semibold mb-4 block">Portfolio</span>
        <h2 class="text-7xl md:text-8xl font-bold text-[#3A3A3A] mb-6 font-serif">
          OUR <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#D4AF37] to-[#C5A572]">PROJECTS</span>
        </h2>
        <p class="text-[#6B6B6B] text-xl font-serif italic">Karya terbaik kami untuk Anda</p>
      </div>

      <!-- Enhanced Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10 mb-16">
        <!-- Project Card 1 -->
        <div class="group relative overflow-hidden rounded-[2rem] bg-white shadow-xl hover-lift cursor-pointer border border-[#C5A572]/10">
          <div class="aspect-[4/3] bg-gradient-to-br from-[#F5F2EB] to-[#E8E4DC] relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center transform group-hover:scale-110 transition-transform duration-500">
                <div class="w-20 h-20 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-3xl flex items-center justify-center mx-auto mb-4 border-2 border-white/50 shadow-xl">
                  <span class="text-4xl font-bold text-white font-serif">1</span>
                </div>
                <span class="inline-block px-4 py-1.5 bg-white/80 backdrop-blur-sm rounded-full text-sm font-medium text-[#6B6B6B] border border-[#C5A572]/20">Commercial</span>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#2C2C2C] via-[#2C2C2C]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute inset-0 flex items-end p-8 translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
              <div class="w-full">
                <h3 class="text-white font-bold text-2xl mb-3 opacity-0 group-hover:opacity-100 transition-opacity font-serif" style="transition-delay: 0.1s;">Modern Conference Room</h3>
                <p class="text-white/80 text-sm mb-4 opacity-0 group-hover:opacity-100 transition-opacity" style="transition-delay: 0.15s;">Professional workspace design</p>
                <button class="px-8 py-3 bg-gradient-to-r from-[#D4AF37] to-[#C5A572] text-white rounded-full text-sm font-semibold opacity-0 group-hover:opacity-100 transition-all hover:shadow-xl uppercase tracking-wider" style="transition-delay: 0.2s;">View Details</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Repeat similar structure for other project cards -->
        <div class="group relative overflow-hidden rounded-[2rem] bg-white shadow-xl hover-lift cursor-pointer border border-[#C5A572]/10">
          <div class="aspect-[4/3] bg-gradient-to-br from-[#F5F2EB] to-[#E8E4DC] relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center transform group-hover:scale-110 transition-transform duration-500">
                <div class="w-20 h-20 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-3xl flex items-center justify-center mx-auto mb-4 border-2 border-white/50 shadow-xl">
                  <span class="text-4xl font-bold text-white font-serif">2</span>
                </div>
                <span class="inline-block px-4 py-1.5 bg-white/80 backdrop-blur-sm rounded-full text-sm font-medium text-[#6B6B6B] border border-[#C5A572]/20">Commercial</span>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#2C2C2C] via-[#2C2C2C]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute inset-0 flex items-end p-8 translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
              <div class="w-full">
                <h3 class="text-white font-bold text-2xl mb-3 opacity-0 group-hover:opacity-100 transition-opacity font-serif" style="transition-delay: 0.1s;">Executive Office</h3>
                <p class="text-white/80 text-sm mb-4 opacity-0 group-hover:opacity-100 transition-opacity" style="transition-delay: 0.15s;">Sophisticated executive space</p>
                <button class="px-8 py-3 bg-gradient-to-r from-[#D4AF37] to-[#C5A572] text-white rounded-full text-sm font-semibold opacity-0 group-hover:opacity-100 transition-all hover:shadow-xl uppercase tracking-wider" style="transition-delay: 0.2s;">View Details</button>
              </div>
            </div>
          </div>
        </div>

        <div class="group relative overflow-hidden rounded-[2rem] bg-white shadow-xl hover-lift cursor-pointer border border-[#C5A572]/10">
          <div class="aspect-[4/3] bg-gradient-to-br from-[#F5F2EB] to-[#E8E4DC] relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center transform group-hover:scale-110 transition-transform duration-500">
                <div class="w-20 h-20 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-3xl flex items-center justify-center mx-auto mb-4 border-2 border-white/50 shadow-xl">
                  <span class="text-4xl font-bold text-white font-serif">3</span>
                </div>
                <span class="inline-block px-4 py-1.5 bg-white/80 backdrop-blur-sm rounded-full text-sm font-medium text-[#6B6B6B] border border-[#C5A572]/20">Commercial</span>
              </div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#2C2C2C] via-[#2C2C2C]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="absolute inset-0 flex items-end p-8 translate-y-8 group-hover:translate-y-0 transition-transform duration-500">
              <div class="w-full">
