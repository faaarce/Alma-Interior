          <circle cx="100" cy="100" r="40" fill="currentColor" />
          <line x1="150" y1="100" x2="170" y2="100" stroke="currentColor" stroke-width="3" />
          <line x1="30" y1="100" x2="50" y2="100" stroke="currentColor" stroke-width="3" />
          <line x1="100" y1="30" x2="100" y2="50" stroke="currentColor" stroke-width="3" />
          <line x1="100" y1="150" x2="100" y2="170" stroke="currentColor" stroke-width="3" />
        </svg>
