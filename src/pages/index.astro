      <!-- View All Button -->
      <button class="bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl">
