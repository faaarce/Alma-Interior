                        class="w-full h-full object-cover"
                      />
                    </div>
                    
                    <!-- Menu Items -->
                    <div class="flex-1 p-8">
                      <div class="grid grid-cols-3 gap-x-8 gap-y-4">
                        <!-- Column 1 -->
                        <div class="space-y-3">
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Homepage</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Services</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Reviews</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Projects</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Project Details</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">404</a>
                        </div>
                        
                        <!-- Column 2 -->
                        <div class="space-y-3">
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">About</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Blog</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Blog Details</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Gallery</a>
                          <a href="#" class="block text-teal-900 hover:text-teal-700 font-medium text-sm transition-colors">Career</a>
