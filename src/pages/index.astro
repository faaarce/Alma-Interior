      <!-- Decorative Elements -->
      <div class="absolute bottom-0 left-0 w-64 h-64 opacity-10">
        <svg viewBox="0 0 200 200" class="w-full h-full text-[#D4AF37]">
          <path d="M100 20 L110 60 L150 60 L118 84 L130 124 L100 100 L70 124 L82 84 L50 60 L90 60 Z" fill="currentColor" />
        </svg>
      </div>


      <div class="absolute top-32 right-20 w-48 h-48 opacity-5">
