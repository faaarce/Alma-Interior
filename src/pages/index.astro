  <!-- Services Section -->
  <section id="services" class="py-24 bg-gradient-to-b from-[#E8E4DC] to-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-8">
      <div class="flex items-end justify-between mb-16">
        <div>
          <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4">SERVICES</p>
          <h2 class="text-6xl font-bold text-[#3A3A3A] leading-tight font-serif">
            Get your dream home<br />with expert help.
          </h2>
        </div>
        <button class="bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl">
