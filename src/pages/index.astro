    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 10%; left: 20%; animation-delay: 0s; animation-duration: 3s;"></div>
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 30%; left: 80%; animation-delay: 1s; animation-duration: 4s;"></div>
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 60%; left: 10%; animation-delay: 2s; animation-duration: 2.5s;"></div>
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 80%; left: 70%; animation-delay: 0.5s; animation-duration: 3.5s;"></div>
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 15%; left: 50%; animation-delay: 1.5s; animation-duration: 4s;"></div>
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 45%; left: 30%; animation-delay: 0.8s; animation-duration: 3s;"></div>
      <div class="absolute w-1 h-1 bg-white rounded-full animate-pulse" style="top: 70%; left: 90%; animation-delay: 2.5s; animation-duration: 2s;"></div>
