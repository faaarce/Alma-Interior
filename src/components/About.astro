---
interface Stat {
  value: string;
  label: string;
  description: string;
}

interface GalleryImage {
  src: string;
  alt: string;
  widthClass: string;
  heightClass: string;
}

interface Props {
  sectionLabel?: string;
  heading?: string;
  paragraphs?: string[];
  stats?: Stat[];
  galleryImages?: GalleryImage[];
}

const {
  sectionLabel = 'ABOUT US',
  heading = 'Alma<br />Interior.',
  paragraphs = [
    'Kami membantu mewujudkan ruang impian anda dengan desain modern, pengerjaan rapi, dan material berkualitas.',
    'Setiap project dikerjakan sesuai kebutuhan dan budget klien.',
  ],
  stats = [
    { value: '8K', label: 'Interior Projects', description: 'Designs we have finished in last 32 years.' },
    { value: '31', label: 'Years of Works', description: 'Designs we have finished in last 32 years.' },
    { value: '12K', label: 'Satisfied Clients', description: 'Designs we have finished in last 32 years.' },
    { value: '97%', label: 'Happy Rate', description: 'Designs we have finished in last 32 years.' },
  ],
  galleryImages = [
    { src: 'https://images.unsplash.com/photo-1615529182904-14819c35db37?w=500&h=700&fit=crop', alt: 'Modern minimalist interior', widthClass: 'w-64', heightClass: 'h-96' },
    { src: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=800&h=600&fit=crop', alt: 'Elegant teal interior', widthClass: 'w-[28rem]', heightClass: 'h-80' },
    { src: 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=600&h=900&fit=crop', alt: 'Contemporary living room', widthClass: 'w-72', heightClass: 'h-[28rem]' },
    { src: 'https://images.unsplash.com/photo-1600210492493-0946911123ea?w=700&h=600&fit=crop', alt: 'Modern workspace', widthClass: 'w-80', heightClass: 'h-72' },
    { src: 'https://images.unsplash.com/photo-1615874694520-474822394e73?w=800&h=500&fit=crop', alt: 'Minimalist space', widthClass: 'w-96', heightClass: 'h-64' },
  ],
} = Astro.props;
---

<section id="about" class="py-24 bg-[#E8E4DC] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-8 relative z-10">
    <!-- Header -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-16">
      <div>
        <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4">{sectionLabel}</p>
        <h2 class="text-6xl font-bold text-[#3A3A3A] leading-tight font-serif" set:html={heading} />
      </div>
      <div class="flex flex-col justify-center">
        {paragraphs.map((text) => (
          <p class="text-xl text-[#6B6B6B] mb-6 last:mb-0">{text}</p>
        ))}
      </div>
    </div>

    <!-- Scrolling Gallery -->
    <div class="overflow-hidden mb-20">
      <div class="flex items-end space-x-6 animate-scroll">
        {/* Original + duplicate for seamless loop */}
        {[...galleryImages, ...galleryImages.slice(0, 3)].map((img) => (
          <div class={`flex-shrink-0 ${img.widthClass} ${img.heightClass} rounded-2xl overflow-hidden shadow-lg`}>
            <img src={img.src} alt={img.alt} class="w-full h-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-12">
      {stats.map((stat) => (
        <div class="text-center">
          <h3 class="text-6xl font-bold text-[#3A3A3A] mb-4">{stat.value}</h3>
          <p class="text-xl font-semibold text-[#3A3A3A] mb-2">{stat.label}</p>
          <p class="text-[#6B6B6B]">{stat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-scroll {
    animation: scroll 30s linear infinite;
  }
  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>