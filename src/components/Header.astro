---
interface NavLink {
  label: string;
  href: string;
}

interface DropdownLink {
  label: string;
  href: string;
}

interface Props {
  navLinks?: NavLink[];
  dropdownLinks?: DropdownLink[][];
  ctaLabel?: string;
}

const {
  navLinks = [
    { label: 'Services', href: '#services' },
    { label: 'Contact', href: '#contact' },
  ],
  dropdownLinks = [
    [
      { label: 'Homepage', href: '#' },
      { label: 'Services', href: '#services' },
      { label: 'Reviews', href: '#reviews' },
      { label: 'Projects', href: '#projects' },
      { label: 'Project Details', href: '#' },
      { label: '404', href: '#' },
    ],
    [
      { label: 'About', href: '#about' },
      { label: 'Blog', href: '#' },
      { label: 'Blog Details', href: '#' },
      { label: 'Gallery', href: '#' },
      { label: 'Career', href: '#' },
    ],
    [
      { label: 'Terms', href: '#' },
      { label: 'Privacy', href: '#' },
      { label: 'FAQs', href: '#' },
      { label: 'Contact', href: '#contact' },
      { label: 'Elements', href: '#' },
    ],
  ],
  ctaLabel = 'Book',
} = Astro.props;
---

<header
  id="header"
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 transition-all duration-500 w-full max-w-6xl px-4"
>
  <div
    id="headerInner"
    class="header-dark bg-white/10 backdrop-blur-lg rounded-full shadow-lg border border-white/20 px-8 py-4 transition-all duration-500"
  >
    <div class="flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full overflow-hidden">
          <img src="/images/alma.png" alt="Alma Interior" class="w-full h-full object-cover" />
        </div>
        <span class="header-logo-text text-xl font-bold tracking-wider transition-colors duration-500 text-white">ALMA INTERIOR</span>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        <!-- All Pages Dropdown -->
        <div class="relative group">
          <button class="header-nav-link transition-colors duration-500 text-white/80 hover:text-white flex items-center gap-1 text-sm font-medium">
            All Pages
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-6 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
            <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-100 w-[600px]">
              <div class="flex">
                <div class="w-48 bg-gradient-to-br from-slate-100 to-slate-200 flex-shrink-0">
                  <img
                    src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=400&h=400&fit=crop"
                    alt="Interior preview"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="flex-1 p-8">
                  <div class="grid grid-cols-3 gap-x-8 gap-y-4">
                    {dropdownLinks.map((column) => (
                      <div class="space-y-3">
                        {column.map((link) => (
                          <a
                            href={link.href}
                            class="block text-teal-900 hover:text-[#C5A572] font-medium text-sm transition-colors"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {navLinks.map((link) => (
          <a
            href={link.href}
            class="header-nav-link transition-colors duration-500 text-white/80 hover:text-white text-sm font-medium"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div>
        <button class="bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-6 py-2.5 rounded-full transition-all duration-300 hover:scale-105 font-medium shadow-lg text-sm">
          {ctaLabel}
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /* Dark sections (Hero, WorkingProcess, CTA) — white text */
  .header-dark {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Light sections (About, Projects, Services, Reviews) — dark text */
  .header-light {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(20px) !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08) !important;
  }

  .header-light .header-logo-text {
    color: #3A3A3A !important;
  }
  .header-light .header-nav-link {
    color: rgba(58, 58, 58, 0.7) !important;
  }
  .header-light .header-nav-link:hover {
    color: #3A3A3A !important;
  }
</style>

<script>
  const headerInner = document.getElementById('headerInner');

  // Sections with light backgrounds where header text should be dark
  const lightSections = ['about', 'projects', 'services', 'reviews'];

  function updateHeader() {
    if (!headerInner) return;

    // Check which section the header is currently overlapping
    const headerRect = headerInner.getBoundingClientRect();
    const headerMid = headerRect.top + headerRect.height / 2;

    let isOverLight = false;

    for (const id of lightSections) {
      const section = document.getElementById(id);
      if (!section) continue;
      const rect = section.getBoundingClientRect();
      if (rect.top <= headerMid && rect.bottom >= headerMid) {
        isOverLight = true;
        break;
      }
    }

    if (isOverLight) {
      headerInner.classList.add('header-light');
      headerInner.classList.remove('header-dark');
    } else {
      headerInner.classList.remove('header-light');
      headerInner.classList.add('header-dark');
    }

    // Extra blur on scroll
    if (window.scrollY > 100) {
      headerInner.classList.add('shadow-2xl');
    } else {
      headerInner.classList.remove('shadow-2xl');
    }
  }

  window.addEventListener('scroll', updateHeader, { passive: true });
  window.addEventListener('resize', updateHeader, { passive: true });
  // Run on load
  updateHeader();
</script>