---
interface NavLink {
  label: string;
  href: string;
}

interface DropdownLink {
  label: string;
  href: string;
}

interface Props {
  navLinks?: NavLink[];
  dropdownLinks?: DropdownLink[][];
  ctaLabel?: string;
}

const {
  navLinks = [
    { label: 'Services', href: '#services' },
    { label: 'Contact', href: '#contact' },
  ],
  dropdownLinks = [
    [
      { label: 'Homepage', href: '#' },
      { label: 'Services', href: '#services' },
      { label: 'Reviews', href: '#reviews' },
      { label: 'Projects', href: '#projects' },
      { label: 'Project Details', href: '#' },
      { label: '404', href: '#' },
    ],
    [
      { label: 'About', href: '#about' },
      { label: 'Blog', href: '#' },
      { label: 'Blog Details', href: '#' },
      { label: 'Gallery', href: '#' },
      { label: 'Career', href: '#' },
    ],
    [
      { label: 'Terms', href: '#' },
      { label: 'Privacy', href: '#' },
      { label: 'FAQs', href: '#' },
      { label: 'Contact', href: '#contact' },
      { label: 'Elements', href: '#' },
    ],
  ],
  ctaLabel = 'Book',
} = Astro.props;
---

<header
  id="header"
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 w-full max-w-6xl px-4"
>
  <div
    id="headerInner"
    class="bg-white/10 backdrop-blur-lg rounded-full shadow-lg border border-white/20 px-8 py-4 transition-all duration-300"
  >
    <div class="flex justify-between items-center">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z" />
          </svg>
        </div>
        <span class="text-xl font-bold text-white tracking-wider">ALMA INTERIOR</span>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-8">
        <!-- All Pages Dropdown -->
        <div class="relative group">
          <button class="text-white/80 hover:text-white transition flex items-center gap-1 text-sm font-medium">
            All Pages
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-6 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
            <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-100 w-[600px]">
              <div class="flex">
                <div class="w-48 bg-gradient-to-br from-slate-100 to-slate-200 flex-shrink-0">
                  <img
                    src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=400&h=400&fit=crop"
                    alt="Interior preview"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="flex-1 p-8">
                  <div class="grid grid-cols-3 gap-x-8 gap-y-4">
                    {dropdownLinks.map((column) => (
                      <div class="space-y-3">
                        {column.map((link) => (
                          <a
                            href={link.href}
                            class="block text-teal-900 hover:text-[#C5A572] font-medium text-sm transition-colors"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-white/80 hover:text-white transition-colors text-sm font-medium"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div>
        <button class="bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-6 py-2.5 rounded-full transition-all duration-300 hover:scale-105 font-medium shadow-lg text-sm">
          {ctaLabel}
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const headerInner = document.getElementById('headerInner');

  function updateHeader() {
    if (!headerInner) return;
    if (window.scrollY > 100) {
      headerInner.classList.remove('bg-white/10', 'backdrop-blur-lg', 'shadow-lg');
      headerInner.classList.add('bg-white/20', 'backdrop-blur-xl', 'shadow-2xl');
    } else {
      headerInner.classList.remove('bg-white/20', 'backdrop-blur-xl', 'shadow-2xl');
      headerInner.classList.add('bg-white/10', 'backdrop-blur-lg', 'shadow-lg');
    }
  }

  window.addEventListener('scroll', updateHeader);
</script>