---
interface Project {
  title: string;
  category: string;
  image: string;
  alt: string;
}

interface Props {
  sectionLabel?: string;
  heading?: string;
  projects?: Project[];
  ctaLabel?: string;
}

const {
  sectionLabel = 'WORKS',
  heading = 'Our Projects &amp;<br />Designs',
  projects = [
    {
      title: 'Modern Living Space',
      category: 'Interior Design',
      image: '/images/project3.jpg',
      alt: 'Modern living room interior',
    },
    {
      title: 'Elegant Interior',
      category: 'Interior Design',
      image: '/images/project7.jpg',
      alt: 'Elegant interior design',
    },
    {
      title: 'Office Interior',
      category: 'Interior Design',
      image: '/images/project11.jpg',
      alt: 'Office interior design',
    },
    {
      title: 'Kitchen Design',
      category: 'Custom Furniture',
      image: '/images/project5.jpg',
      alt: 'Kitchen interior design',
    },
    {
      title: 'Studio Interior',
      category: 'Architecture Plan',
      image: '/images/project14.jpg',
      alt: 'Studio interior design',
    },
    {
      title: 'Home Office',
      category: 'Interior Design',
      image: '/images/project9.jpg',
      alt: 'Home office interior',
    },
    {
      title: 'Living Corner',
      category: 'Architecture Plan',
      image: '/images/project2.jpg',
      alt: 'Living corner interior',
    },
    {
      title: 'Dining Space',
      category: 'Interior Design',
      image: '/images/project13.jpg',
      alt: 'Dining space interior',
    },
  ],
  ctaLabel = 'View All Projects',
} = Astro.props;

const leftProjects = projects.filter((_, i) => i % 2 === 0);
const rightProjects = projects.filter((_, i) => i % 2 === 1);

const leftHeights = ['h-[380px]', 'h-[260px]', 'h-[320px]', 'h-[280px]'];
const rightHeights = ['h-[280px]', 'h-[340px]', 'h-[260px]', 'h-[360px]'];
---

<section id="projects" class="py-24 bg-white relative overflow-hidden">
  <!-- Floating decorative elements -->
  <div class="prj-float absolute top-40 right-0 w-80 h-80 border border-[#C5A572]/5 rounded-full pointer-events-none"></div>
  <div class="prj-float-reverse absolute bottom-60 left-0 w-56 h-56 border border-[#C5A572]/5 rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 mb-16">
      <!-- Left: heading + projects -->
      <div>
        <div class="prj-reveal">
          <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4 prj-label">{sectionLabel}</p>
          <h2 class="text-6xl font-bold text-[#3A3A3A] mb-4 leading-tight font-serif prj-heading" set:html={heading} />
          <div class="prj-head-line mb-16 h-[2px] w-0 bg-gradient-to-r from-[#C5A572] to-transparent"></div>
        </div>

        <div class="space-y-32">
          {leftProjects.map((project, index) => (
            <div class="group cursor-pointer prj-card" data-side="left">
              <!-- Image with curtain reveal -->
              <div class={`relative overflow-hidden rounded-2xl mb-6 ${leftHeights[index % leftHeights.length]} bg-gray-100`}>
                <div class="prj-img-clip w-full h-full">
                  <img
                    src={project.image}
                    alt={project.alt}
                    class="w-full h-full object-cover prj-img-zoom group-hover:scale-110 transition-transform duration-700"
                    loading="lazy"
                  />
                </div>
                <!-- Hover overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                <!-- Number badge -->
                <div class="prj-badge absolute top-4 left-4 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center text-white font-bold text-sm border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-300" style={`transform: rotate(-90deg);`}>
                  0{index * 2 + 1}
                </div>
                <!-- Hover arrow -->
                <div class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-[#C5A572] flex items-center justify-center text-white translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </div>
              </div>
              <!-- Text with gold line -->
              <div class="prj-text">
                <div class="flex items-start justify-between">
                  <div>
                    <h3 class="text-2xl font-bold text-[#3A3A3A] mb-2 flex items-center group-hover:text-[#C5A572] transition-colors duration-300">
                      <span class="prj-dot w-0 h-2 bg-[#C5A572] rounded-full mr-0 transition-all duration-500" />
                      {project.title}
                    </h3>
                    <p class="text-[#6B6B6B]">{project.category}</p>
                  </div>
                  <div class="text-[#C5A572] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H7M17 7V17" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: projects only (offset down) -->
      <div class="mt-8 md:mt-24 space-y-32">
        {rightProjects.map((project, index) => (
          <div class="group cursor-pointer prj-card" data-side="right">
            <div class={`relative overflow-hidden rounded-2xl mb-6 ${rightHeights[index % rightHeights.length]} bg-gray-100`}>
              <div class="prj-img-clip w-full h-full">
                <img
                  src={project.image}
                  alt={project.alt}
                  class="w-full h-full object-cover prj-img-zoom group-hover:scale-110 transition-transform duration-700"
                  loading="lazy"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <div class="prj-badge absolute top-4 left-4 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center text-white font-bold text-sm border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-300" style={`transform: rotate(-90deg);`}>
                0{index * 2 + 2}
              </div>
              <div class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-[#C5A572] flex items-center justify-center text-white translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </div>
            </div>
            <div class="prj-text">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="text-2xl font-bold text-[#3A3A3A] mb-2 flex items-center group-hover:text-[#C5A572] transition-colors duration-300">
                    <span class="prj-dot w-0 h-2 bg-[#C5A572] rounded-full mr-0 transition-all duration-500" />
                    {project.title}
                  </h3>
                  <p class="text-[#6B6B6B]">{project.category}</p>
                </div>
                <div class="text-[#C5A572] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA Button -->
    <button class="prj-cta bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl relative overflow-hidden">
      <span class="relative z-10">{ctaLabel}</span>
      <svg class="w-5 h-5 relative z-10 prj-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 17L17 7M17 7H7M17 7V17" />
      </svg>
      <div class="prj-cta-shimmer absolute inset-0"></div>
    </button>
  </div>
</section>

<style>
  /* ===== HEADING ===== */
  .prj-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .prj-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Label tracking */
  .prj-label {
    letter-spacing: 0.4em;
    transition: letter-spacing 1.2s ease-out 0.2s;
  }
  .visible .prj-label {
    letter-spacing: 0.15em;
  }

  /* Heading clip reveal */
  .prj-heading {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1s cubic-bezier(0.77, 0, 0.175, 1) 0.3s;
  }
  .visible .prj-heading {
    clip-path: inset(0 0% 0 0);
  }

  /* Heading line grow */
  .prj-head-line {
    transition: width 0.8s ease-out 0.8s;
  }
  .visible .prj-head-line {
    width: 40%;
  }

  /* ===== CARDS ===== */
  .prj-card {
    opacity: 0;
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .prj-card[data-side="left"] {
    transform: translateX(-60px) translateY(30px);
  }
  .prj-card[data-side="right"] {
    transform: translateX(60px) translateY(30px);
  }
  .prj-card.visible {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }

  /* Card hover lift */
  .prj-card.visible:hover {
    transform: translateY(-8px);
    transition: transform 0.4s ease;
  }

  /* ===== IMAGE CURTAIN REVEAL ===== */
  .prj-img-clip {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1s cubic-bezier(0.77, 0, 0.175, 1) 0.15s;
  }
  .visible .prj-img-clip {
    clip-path: inset(0 0 0 0);
  }

  /* Image Ken Burns on reveal */
  .prj-img-zoom {
    transform: scale(1.15);
    transition: transform 6s ease-out;
  }
  .visible .prj-img-zoom {
    transform: scale(1);
  }
  .group:hover .prj-img-zoom {
    transform: scale(1.1) !important;
    transition: transform 0.7s ease !important;
  }

  /* Number badge spin in on hover */
  .prj-badge {
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .group:hover .prj-badge {
    transform: rotate(0deg) !important;
    opacity: 1;
  }

  /* ===== TEXT ANIMATION ===== */
  .prj-text {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease-out 0.4s, transform 0.6s ease-out 0.4s;
  }
  .visible .prj-text {
    opacity: 1;
    transform: translateY(0);
  }

  /* Gold dot grows on hover */
  .group:hover .prj-dot {
    width: 0.5rem;
    margin-right: 0.75rem;
  }

  /* ===== CTA BUTTON ===== */
  .prj-cta {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .prj-cta.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .prj-cta.visible {
    animation: prj-cta-glow 2s ease-in-out 0.5s 1;
  }
  @keyframes prj-cta-glow {
    0%, 100% { box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); }
    50% { box-shadow: 0 0 30px 5px rgba(212, 175, 55, 0.2); }
  }

  .prj-cta-arrow {
    transition: transform 0.3s ease;
  }
  .prj-cta:hover .prj-cta-arrow {
    transform: translate(3px, -3px);
  }

  .prj-cta-shimmer {
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
    background-size: 200% 100%;
    animation: prj-shimmer 3s ease-in-out infinite;
  }
  @keyframes prj-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* ===== FLOATING DECORATIONS ===== */
  .prj-float {
    animation: prj-drift 18s ease-in-out infinite;
  }
  .prj-float-reverse {
    animation: prj-drift-reverse 14s ease-in-out infinite;
  }
  @keyframes prj-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-20px, 15px) scale(1.05); }
    66% { transform: translate(10px, -10px) scale(0.95); }
  }
  @keyframes prj-drift-reverse {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(15px, -20px) scale(0.95); }
    66% { transform: translate(-10px, 10px) scale(1.05); }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('#projects .prj-reveal, #projects .prj-card, #projects .prj-cta').forEach((el) => observer.observe(el));
</script>