---
interface Project {
  title: string;
  category: string;
  image: string;
  alt: string;
}

interface Props {
  sectionLabel?: string;
  heading?: string;
  projects?: Project[];
  ctaLabel?: string;
}

const {
  sectionLabel = 'WORKS',
  heading = 'Our Projects &amp;<br />Designs',
  projects = [
    {
      title: 'Modern Living Space',
      category: 'Interior Design',
      image: '/images/project3.jpg',
      alt: 'Modern living room interior',
    },
    {
      title: 'Elegant Interior',
      category: 'Interior Design',
      image: '/images/project7.jpg',
      alt: 'Elegant interior design',
    },
    {
      title: 'Office Interior',
      category: 'Interior Design',
      image: '/images/project11.jpg',
      alt: 'Office interior design',
    },
    {
      title: 'Kitchen Design',
      category: 'Custom Furniture',
      image: '/images/project5.jpg',
      alt: 'Kitchen interior design',
    },
    {
      title: 'Studio Interior',
      category: 'Architecture Plan',
      image: '/images/project14.jpg',
      alt: 'Studio interior design',
    },
    {
      title: 'Home Office',
      category: 'Interior Design',
      image: '/images/project9.jpg',
      alt: 'Home office interior',
    },
    {
      title: 'Living Corner',
      category: 'Architecture Plan',
      image: '/images/project2.jpg',
      alt: 'Living corner interior',
    },
    {
      title: 'Dining Space',
      category: 'Interior Design',
      image: '/images/project13.jpg',
      alt: 'Dining space interior',
    },
  ],
  ctaLabel = 'View All Projects',
} = Astro.props;

const leftProjects = projects.filter((_, i) => i % 2 === 0);
const rightProjects = projects.filter((_, i) => i % 2 === 1);

const leftHeights = ['h-[380px]', 'h-[260px]', 'h-[320px]', 'h-[280px]'];
const rightHeights = ['h-[280px]', 'h-[340px]', 'h-[260px]', 'h-[360px]'];
---

<section id="projects" class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 mb-16">
      <!-- Left: heading + projects -->
      <div>
        <div class="prj-reveal">
          <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4">{sectionLabel}</p>
          <h2 class="text-6xl font-bold text-[#3A3A3A] mb-16 leading-tight font-serif" set:html={heading} />
        </div>

        <div class="space-y-32">
          {leftProjects.map((project, index) => (
            <div class="group cursor-pointer prj-reveal">
              <div class={`relative overflow-hidden rounded-2xl mb-6 ${leftHeights[index % leftHeights.length]} bg-gray-100`}>
                <img
                  src={project.image}
                  alt={project.alt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              </div>
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="text-2xl font-bold text-[#3A3A3A] mb-2 flex items-center">
                    <span class="w-2 h-2 bg-[#C5A572] rounded-full mr-3" />
                    {project.title}
                  </h3>
                  <p class="text-[#6B6B6B]">{project.category}</p>
                </div>
                <div class="text-[#C5A572] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H7M17 7V17" />
                  </svg>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: projects only (offset down) -->
      <div class="mt-8 md:mt-24 space-y-32">
        {rightProjects.map((project, index) => (
          <div class="group cursor-pointer prj-reveal">
            <div class={`relative overflow-hidden rounded-2xl mb-6 ${rightHeights[index % rightHeights.length]} bg-gray-100`}>
              <img
                src={project.image}
                alt={project.alt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            </div>
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-2xl font-bold text-[#3A3A3A] mb-2 flex items-center">
                  <span class="w-2 h-2 bg-[#C5A572] rounded-full mr-3" />
                  {project.title}
                </h3>
                <p class="text-[#6B6B6B]">{project.category}</p>
              </div>
              <div class="text-[#C5A572] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <button class="prj-reveal bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl">
      <span>{ctaLabel}</span>
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 17L17 7M17 7H7M17 7V17" />
      </svg>
    </button>
  </div>
</section>

<style>
  .prj-reveal {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .prj-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('#projects .prj-reveal').forEach((el) => observer.observe(el));
</script>