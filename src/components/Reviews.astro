---
interface Review {
  quote: string;
  name: string;
  location: string;
}

interface Props {
  sectionLabel?: string;
  heading?: string;
  reviews?: Review[];
  sideImage?: string;
}

const {
  sectionLabel = 'REVIEWS',
  heading = 'Customer Reviews',
  reviews = [
    {
      quote: 'Pelayanan yang ramah dan desain interior yang memukau! Sangat puas dengan hasil akhir. Terimakasih Alma Interior!',
      name: 'Mr. Aru Nika',
      location: 'Jakarta',
    },
    {
      quote: 'Tim Alma Interior terpercaya dan amanah ini repurchase ke 3 kali. Proses desain dan pembangunan berjalan lancar. Kami sangat senang dengan rumah kami yang baru!',
      name: 'Mr. Rowi Jaya',
      location: 'Tangerang',
    },
    {
      quote: 'Terima kasih Alma, untuk hasil kitchen nya rapih dan sesuai dengan gambar memuaskan dan sesuai amanah.',
      name: 'Mr. Soni',
      location: 'BSD',
    },
  ],
  sideImage = '/images/project1.jpg',
} = Astro.props;
---

<section id="reviews" class="py-24 bg-gradient-to-b from-[#E8E4DC] to-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <!-- Left Side -->
      <div>
        <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4">{sectionLabel}</p>
        <h2 class="text-5xl font-bold text-[#3A3A3A] mb-12 leading-tight font-serif">{heading}</h2>

        <div class="mb-8">
          <div id="reviewContainer">
            {reviews.map((review, index) => (
              <div class:list={['review-item', { active: index === 0, hidden: index !== 0 }]}>
                <blockquote class="text-2xl text-[#3A3A3A] leading-relaxed font-serif italic mb-8">
                  "{review.quote}"
                </blockquote>
                <div class="flex items-center space-x-4">
                  <div>
                    <p class="text-xl font-semibold text-[#3A3A3A]">{review.name}</p>
                    <p class="text-[#C5A572]">{review.location}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Navigation -->
        <div class="flex items-center space-x-4">
          <button
            id="prevReview"
            aria-label="Previous review"
            class="w-12 h-12 rounded-full bg-[#3A3A3A]/10 hover:bg-[#3A3A3A]/20 flex items-center justify-center transition-all duration-300"
          >
            <svg class="w-6 h-6 text-[#3A3A3A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M5 12l7-7M5 12l7 7" />
            </svg>
          </button>
          <button
            id="nextReview"
            aria-label="Next review"
            class="w-12 h-12 rounded-full bg-[#3A3A3A]/10 hover:bg-[#3A3A3A]/20 flex items-center justify-center transition-all duration-300"
          >
            <svg class="w-6 h-6 text-[#3A3A3A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M19 12l-7-7M19 12l-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Right Side Image -->
      <div class="relative">
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img
            src={sideImage}
            alt="Modern interior space"
            class="w-full h-[600px] object-cover"
            loading="lazy"
          />
        </div>
        <div class="absolute -top-6 -right-6 w-32 h-32 bg-[#D4AF37] rounded-full opacity-10 blur-3xl" />
        <div class="absolute -bottom-6 -left-6 w-40 h-40 bg-[#C5A572] rounded-full opacity-10 blur-3xl" />
      </div>
    </div>
  </div>

  <!-- Decorative star -->
  <div class="absolute top-20 left-20 w-12 h-12 opacity-10">
    <svg viewBox="0 0 24 24" class="w-full h-full text-[#D4AF37]" fill="currentColor">
      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
    </svg>
  </div>
</section>

<style>
  #reviewContainer {
    position: relative;
    min-height: 300px;
  }
  .review-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transition: opacity 0.5s ease;
  }
</style>

<script>
  let currentReview = 0;
  const reviews = document.querySelectorAll('.review-item');
  const prevBtn = document.getElementById('prevReview');
  const nextBtn = document.getElementById('nextReview');

  function showReview(index: number) {
    reviews.forEach((review, i) => {
      if (i === index) {
        review.classList.remove('hidden');
        review.classList.add('active');
      } else {
        review.classList.add('hidden');
        review.classList.remove('active');
      }
    });
  }

  prevBtn?.addEventListener('click', () => {
    currentReview = (currentReview - 1 + reviews.length) % reviews.length;
    showReview(currentReview);
  });

  nextBtn?.addEventListener('click', () => {
    currentReview = (currentReview + 1) % reviews.length;
    showReview(currentReview);
  });
</script>