---
interface Service {
  title: string;
  description: string;
  image: string;
  alt: string;
}

interface Props {
  sectionLabel?: string;
  heading?: string;
  services?: Service[];
  ctaLabel?: string;
}

const {
  sectionLabel = 'SERVICES',
  heading = 'Get your dream home<br />with expert help.',
  services = [
    {
      title: 'Home Decoration',
      description: 'Efficient use of space is crucial in home interior design. Consider the layout of furniture.',
      image: '/images/project4.jpg',
      alt: 'Home Decoration',
    },
    {
      title: 'Hospitality Decor',
      description: 'Efficient use of space is crucial in home interior design. Consider the layout of furniture.',
      image: '/images/project8.jpg',
      alt: 'Hospitality Decor',
    },
    {
      title: 'Office Space Interior',
      description: 'Efficient use of space is crucial in home interior design. Consider the layout of furniture.',
      image: '/images/project10.jpg',
      alt: 'Office Space Interior',
    },
  ],
  ctaLabel = 'View All Services',
} = Astro.props;
---

<section id="services" class="py-24 bg-gradient-to-b from-[#E8E4DC] to-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-8">
      <div class="svc-reveal">
        <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4 svc-label">{sectionLabel}</p>
        <h2 class="text-6xl font-bold text-[#3A3A3A] leading-tight font-serif svc-heading" set:html={heading} />
      </div>
      <button class="svc-reveal svc-btn bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl flex-shrink-0" style="transition-delay: 0.2s;">
        <span>{ctaLabel}</span>
        <span class="svc-arrow inline-block">↗</span>
      </button>
    </div>

    <!-- Service Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-end">
      {services.map((service, index) => (
        <div
          class:list={['group cursor-pointer svc-card', { '-mt-16': index === 1 }]}
          style={`transition-delay: ${0.3 + 0.25 * index}s;`}
        >
          <div class:list={[
            'relative overflow-hidden rounded-2xl mb-6 bg-gray-100 svc-image-wrap',
            index === 0 ? 'h-[28rem]' : index === 1 ? 'h-[24rem]' : 'h-[30rem]',
          ]}>
            <!-- Image with clip reveal -->
            <div class="svc-image-clip w-full h-full">
              <img
                src={service.image}
                alt={service.alt}
                class="w-full h-full object-cover svc-image-zoom group-hover:scale-110 transition-transform duration-700"
                loading="lazy"
              />
            </div>
            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
            <!-- Number badge -->
            <div class="absolute top-4 left-4 svc-badge w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center text-white font-bold text-sm border border-white/20 opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:rotate-0" style={`transform: rotate(-90deg);`}>
              0{index + 1}
            </div>
            <!-- Hover arrow -->
            <div class="absolute bottom-4 right-4 w-10 h-10 rounded-full bg-[#C5A572] flex items-center justify-center text-white translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </div>
          </div>
          <!-- Text content -->
          <div class="svc-text">
            <div class="flex items-center gap-3 mb-3">
              <div class="svc-title-line w-0 h-[2px] bg-[#C5A572]"></div>
              <h3 class="text-2xl font-bold text-[#3A3A3A] font-serif">{service.title}</h3>
            </div>
            <p class="text-[#6B6B6B] leading-relaxed">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Base reveal */
  .svc-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .svc-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Label tracking animation */
  .svc-label {
    letter-spacing: 0.3em;
    transition: letter-spacing 1s ease-out;
  }
  .visible .svc-label {
    letter-spacing: 0.15em;
  }

  /* Heading line reveal */
  .svc-heading {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.8s cubic-bezier(0.77, 0, 0.175, 1) 0.2s;
  }
  .visible .svc-heading {
    clip-path: inset(0 0% 0 0);
  }

  /* Button glow */
  .svc-btn.visible {
    animation: svc-glow 2s ease-in-out 0.8s 1;
  }
  @keyframes svc-glow {
    0%, 100% { box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); }
    50% { box-shadow: 0 0 30px 5px rgba(212, 175, 55, 0.25); }
  }

  /* Button arrow hover */
  .svc-arrow {
    transition: transform 0.3s ease;
  }
  .svc-btn:hover .svc-arrow {
    transform: translate(3px, -3px);
  }

  /* Card reveal */
  .svc-card {
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .svc-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Image clip-path curtain reveal */
  .svc-image-clip {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1s cubic-bezier(0.77, 0, 0.175, 1);
  }
  .visible .svc-image-clip {
    clip-path: inset(0 0 0 0);
  }

  /* Image slow zoom on reveal */
  .svc-image-zoom {
    transform: scale(1.15);
    transition: transform 6s ease-out;
  }
  .visible .svc-image-zoom {
    transform: scale(1);
  }
  .group:hover .svc-image-zoom {
    transform: scale(1.1) !important;
    transition: transform 0.7s ease !important;
  }

  /* Title line grow */
  .svc-title-line {
    transition: width 0.6s ease-out 0.4s;
  }
  .visible .svc-title-line {
    width: 2rem;
  }

  /* Text fade in */
  .svc-text {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.6s ease-out 0.5s, transform 0.6s ease-out 0.5s;
  }
  .visible .svc-text {
    opacity: 1;
    transform: translateY(0);
  }

  /* Card tilt on hover */
  .svc-card {
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .svc-card.visible:hover {
    transform: translateY(-8px);
    transition: transform 0.4s ease;
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('#services .svc-reveal, #services .svc-card').forEach((el) => observer.observe(el));
</script>