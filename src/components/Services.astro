---
interface Service {
  title: string;
  description: string;
  image: string;
  alt: string;
}

interface Props {
  sectionLabel?: string;
  heading?: string;
  services?: Service[];
  ctaLabel?: string;
}

const {
  sectionLabel = 'SERVICES',
  heading = 'Get your dream home<br />with expert help.',
  services = [
    {
      title: 'Home Decoration',
      description: 'Efficient use of space is crucial in home interior design. Consider the layout of furniture.',
      image: '/images/project4.jpg',
      alt: 'Home Decoration',
    },
    {
      title: 'Hospitality Decor',
      description: 'Efficient use of space is crucial in home interior design. Consider the layout of furniture.',
      image: '/images/project8.jpg',
      alt: 'Hospitality Decor',
    },
    {
      title: 'Office Space Interior',
      description: 'Efficient use of space is crucial in home interior design. Consider the layout of furniture.',
      image: '/images/project10.jpg',
      alt: 'Office Space Interior',
    },
  ],
  ctaLabel = 'View All Services',
} = Astro.props;
---

<section id="services" class="py-24 bg-gradient-to-b from-[#E8E4DC] to-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-8">
    <div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-8">
      <div>
        <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4">{sectionLabel}</p>
        <h2 class="text-6xl font-bold text-[#3A3A3A] leading-tight font-serif" set:html={heading} />
      </div>
      <button class="bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl flex-shrink-0">
        <span>{ctaLabel}</span>
        <span>↗</span>
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-end">
      {services.map((service, index) => (
        <div class:list={['group cursor-pointer', { '-mt-16': index === 1 }]}>
          <div class:list={[
            'relative overflow-hidden rounded-2xl mb-6 bg-gray-100',
            index === 0 ? 'h-[28rem]' : index === 1 ? 'h-[24rem]' : 'h-[30rem]',
          ]}>
            <img
              src={service.image}
              alt={service.alt}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
          </div>
          <h3 class="text-2xl font-bold text-[#3A3A3A] mb-3 font-serif">{service.title}</h3>
          <p class="text-[#6B6B6B] leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>