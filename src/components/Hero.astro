---
interface Props {
  heading?: string;
  subheading?: string;
  ctaLabel?: string;
  backgroundImage?: string;
  badgeText?: string;
}

const {
  heading = 'Design<br />& Build',
  subheading = 'Interior Design & Custom Furniture dengan desain modern dan rapi sesuai kebutuhan anda.',
  ctaLabel = 'Book A Consultation',
  backgroundImage = 'https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=1920&h=1080&fit=crop',
  badgeText = '★ Design & Build • 2024 • Design & Build • 2024 •',
} = Astro.props;
---

<section id="home" class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image with parallax zoom -->
  <div class="absolute inset-0 z-0">
    <img
      src={backgroundImage}
      alt="Modern interior design"
      class="w-full h-full object-cover hero-bg"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
  </div>

  <!-- Animated floating particles -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-[1]">
    {[
      { top: '10%', left: '20%', delay: '0s', size: 'w-1 h-1' },
      { top: '30%', left: '80%', delay: '1s', size: 'w-1.5 h-1.5' },
      { top: '60%', left: '10%', delay: '2s', size: 'w-1 h-1' },
      { top: '80%', left: '70%', delay: '0.5s', size: 'w-2 h-2' },
      { top: '15%', left: '50%', delay: '1.5s', size: 'w-1 h-1' },
      { top: '45%', left: '30%', delay: '0.8s', size: 'w-1.5 h-1.5' },
      { top: '70%', left: '90%', delay: '2.5s', size: 'w-1 h-1' },
      { top: '25%', left: '65%', delay: '1.2s', size: 'w-2 h-2' },
      { top: '55%', left: '45%', delay: '0.3s', size: 'w-1 h-1' },
      { top: '85%', left: '25%', delay: '1.8s', size: 'w-1.5 h-1.5' },
    ].map((p) => (
      <div
        class={`absolute ${p.size} bg-[#D4AF37]/40 rounded-full hero-particle`}
        style={`top: ${p.top}; left: ${p.left}; animation-delay: ${p.delay};`}
      />
    ))}
  </div>

  <!-- Decorative corner lines -->
  <div class="absolute top-12 left-12 z-[2] hero-corner hero-corner-tl">
    <div class="w-16 h-[1px] bg-[#C5A572]/30 hero-line-h"></div>
    <div class="w-[1px] h-16 bg-[#C5A572]/30 hero-line-v"></div>
  </div>
  <div class="absolute bottom-12 right-12 z-[2] hero-corner hero-corner-br">
    <div class="w-16 h-[1px] bg-[#C5A572]/30 hero-line-h ml-auto"></div>
    <div class="w-[1px] h-16 bg-[#C5A572]/30 hero-line-v ml-auto"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- Spinning Badge with Logo -->
    <div class="inline-flex items-center justify-center mb-8 hero-badge">
      <div class="relative w-32 h-32">
        <svg class="w-full h-full animate-spin-slow" viewBox="0 0 200 200">
          <defs>
            <path
              id="circlePath"
              d="M 100, 100 m -80, 0 a 80,80 0 1,1 160,0 a 80,80 0 1,1 -160,0"
            />
          </defs>
          <text class="text-[11px] fill-[#D4AF37] font-medium tracking-[0.3em]">
            <textPath href="#circlePath" startOffset="0">
              {badgeText}
            </textPath>
          </text>
        </svg>
        <div class="absolute inset-0 flex items-center justify-center">
          <img
            src="/images/alma.png"
            alt="Alma Interior Logo"
            class="w-24 h-24 object-contain rounded-full hero-logo-pulse"
          />
        </div>
      </div>
    </div>

    <!-- Heading with split reveal -->
    <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold text-white leading-tight mb-6 font-serif hero-heading" set:html={heading} />

    <!-- Gold divider line -->
    <div class="flex justify-center mb-6">
      <div class="hero-divider h-[2px] w-0 bg-gradient-to-r from-transparent via-[#C5A572] to-transparent"></div>
    </div>

    <p class="text-lg md:text-xl text-[#E8E4DC]/90 mb-10 max-w-2xl mx-auto hero-sub">
      {subheading}
    </p>

    <button class="hero-cta bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-10 py-4 rounded-full transition-all duration-300 hover:scale-105 text-lg font-medium inline-flex items-center gap-2 shadow-2xl relative overflow-hidden">
      <span class="relative z-10">{ctaLabel}</span>
      <svg class="w-5 h-5 relative z-10 hero-cta-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
      <div class="hero-cta-shimmer absolute inset-0"></div>
    </button>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 hero-scroll-hint">
    <div class="flex flex-col items-center gap-2">
      <span class="text-white/40 text-xs tracking-widest uppercase">Scroll</span>
      <div class="w-[1px] h-8 bg-gradient-to-b from-[#C5A572]/50 to-transparent hero-scroll-line"></div>
    </div>
  </div>
</section>

<style>
  /* ===== BACKGROUND ===== */
  .hero-bg {
    transform: scale(1.1);
    animation: hero-bg-zoom 20s ease-out forwards;
  }
  @keyframes hero-bg-zoom {
    0% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }

  /* ===== PARTICLES ===== */
  .hero-particle {
    animation: hero-float 6s ease-in-out infinite;
  }
  @keyframes hero-float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.3;
    }
    25% {
      transform: translate(15px, -20px) scale(1.3);
      opacity: 0.7;
    }
    50% {
      transform: translate(-10px, -35px) scale(0.8);
      opacity: 0.4;
    }
    75% {
      transform: translate(20px, -15px) scale(1.1);
      opacity: 0.6;
    }
  }

  /* ===== CORNER LINES ===== */
  .hero-line-h {
    transform: scaleX(0);
    animation: hero-line-grow-h 0.8s ease-out 1.2s forwards;
  }
  .hero-line-v {
    transform: scaleY(0);
    transform-origin: top;
    animation: hero-line-grow-v 0.8s ease-out 1.4s forwards;
  }
  .hero-corner-tl .hero-line-h { transform-origin: left; }
  .hero-corner-br .hero-line-h { transform-origin: right; }
  .hero-corner-br .hero-line-v { transform-origin: bottom; }
  @keyframes hero-line-grow-h {
    0% { transform: scaleX(0); }
    100% { transform: scaleX(1); }
  }
  @keyframes hero-line-grow-v {
    0% { transform: scaleY(0); }
    100% { transform: scaleY(1); }
  }

  /* ===== SPINNING BADGE ===== */
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }

  .hero-badge {
    opacity: 0;
    transform: scale(0.5) rotate(-180deg);
    animation: hero-badge-in 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
  }
  @keyframes hero-badge-in {
    0% {
      opacity: 0;
      transform: scale(0.5) rotate(-180deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  /* Logo pulse glow */
  .hero-logo-pulse {
    animation: hero-logo-glow 3s ease-in-out infinite 1.5s;
  }
  @keyframes hero-logo-glow {
    0%, 100% { filter: drop-shadow(0 0 0 rgba(212, 175, 55, 0)); }
    50% { filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.3)); }
  }

  /* ===== HEADING ===== */
  .hero-heading {
    opacity: 0;
    clip-path: inset(100% 0 0 0);
    animation: hero-heading-reveal 1s cubic-bezier(0.77, 0, 0.175, 1) 0.5s forwards;
  }
  @keyframes hero-heading-reveal {
    0% {
      opacity: 0;
      clip-path: inset(100% 0 0 0);
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      clip-path: inset(0% 0 0 0);
    }
  }

  /* ===== DIVIDER ===== */
  .hero-divider {
    animation: hero-divider-grow 0.8s ease-out 1s forwards;
  }
  @keyframes hero-divider-grow {
    0% { width: 0; }
    100% { width: 120px; }
  }

  /* ===== SUBHEADING ===== */
  .hero-sub {
    opacity: 0;
    transform: translateY(25px);
    filter: blur(8px);
    animation: hero-sub-in 0.8s ease-out 0.8s forwards;
  }
  @keyframes hero-sub-in {
    0% {
      opacity: 0;
      transform: translateY(25px);
      filter: blur(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* ===== CTA BUTTON ===== */
  .hero-cta {
    opacity: 0;
    transform: translateY(30px);
    animation: hero-cta-in 0.8s ease-out 1s forwards;
  }
  @keyframes hero-cta-in {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* CTA glow pulse after entry */
  .hero-cta {
    animation: hero-cta-in 0.8s ease-out 1s forwards,
               hero-cta-glow 2s ease-in-out 2s 1;
  }
  @keyframes hero-cta-glow {
    0%, 100% { box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
    50% { box-shadow: 0 0 40px 8px rgba(212, 175, 55, 0.25); }
  }

  /* CTA shimmer sweep */
  .hero-cta-shimmer {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(255, 255, 255, 0.2) 50%,
      transparent 60%
    );
    background-size: 200% 100%;
    animation: hero-shimmer 3s ease-in-out 2.5s infinite;
  }
  @keyframes hero-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* CTA arrow hover */
  .hero-cta-arrow {
    transition: transform 0.3s ease;
  }
  .hero-cta:hover .hero-cta-arrow {
    transform: translateX(4px);
  }

  /* ===== SCROLL INDICATOR ===== */
  .hero-scroll-hint {
    opacity: 0;
    animation: hero-scroll-in 0.6s ease-out 1.8s forwards;
  }
  @keyframes hero-scroll-in {
    0% {
      opacity: 0;
      transform: translate(-50%, 20px);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .hero-scroll-line {
    animation: hero-scroll-pulse 2s ease-in-out 2.2s infinite;
  }
  @keyframes hero-scroll-pulse {
    0%, 100% {
      transform: scaleY(1);
      opacity: 0.5;
    }
    50% {
      transform: scaleY(1.5);
      opacity: 1;
    }
  }
</style>