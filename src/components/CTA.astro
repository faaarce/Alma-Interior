---
interface Props {
  heading?: string;
  ctaLabel?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  heading = 'Ready To Build Your<br />Dream Project?',
  ctaLabel = 'Get Started',
  whatsappNumber = '6281717726000',
  whatsappMessage = 'Halo Alma Interior, saya mau konsultasi interior. Mohon info ya, terima kasih',
} = Astro.props;

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section id="contact" class="bg-gradient-to-br from-[#2C2C2C] via-[#1C1C1C] to-[#2C2C2C]">
  <!-- CTA + Links -->
  <div class="max-w-7xl mx-auto px-8 pt-24 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <!-- Left: Heading + Button -->
      <div>
        <h2 class="text-6xl font-bold text-white leading-tight mb-10 font-serif" set:html={heading} />
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 bg-[#E8E4DC] text-[#1C1C1C] px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 hover:bg-white text-lg font-medium shadow-xl"
        >
          <span>{ctaLabel}</span>
          <span>↗</span>
        </a>
      </div>

      <!-- Right: Quick Links + Legal Links -->
      <div class="grid grid-cols-2 gap-12">
        <div>
          <p class="text-[#C5A572] font-semibold mb-6">Quick Links</p>
          <nav class="space-y-4">
            <a href="#projects" class="block text-white/80 hover:text-white transition-colors">Projects</a>
            <a href="#about" class="block text-white/80 hover:text-white transition-colors">About Us</a>
            <a href="#contact" class="block text-white/80 hover:text-white transition-colors">Contact</a>
            <a href="#" class="block text-white/80 hover:text-white transition-colors">Career</a>
          </nav>
        </div>
        <div>
          <p class="text-[#C5A572] font-semibold mb-6">Legal & Policy Links</p>
          <nav class="space-y-4">
            <a href="#" class="block text-white/80 hover:text-white transition-colors">Privacy Policy</a>
            <a href="#" class="block text-white/80 hover:text-white transition-colors">Terms of Service</a>
            <a href="#contact" class="block text-white/80 hover:text-white transition-colors">Contact Us</a>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-8">
    <div class="border-t border-white/10"></div>
  </div>

  <!-- Footer -->
  <div class="max-w-7xl mx-auto px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Logo + Tagline -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z" />
            </svg>
          </div>
          <span class="text-2xl font-bold text-white tracking-wider">ALMA INTERIOR</span>
        </div>
        <p class="text-white/50 leading-relaxed">
          Interior Design & Custom Furniture dengan desain modern dan rapi sesuai kebutuhan anda.
        </p>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4">
        <a href="https://wa.me/6281717726000" target="_blank" rel="noopener noreferrer" class="block text-white/80 hover:text-white transition-colors">
          +62 817-1772-6000
        </a>
        <a href="mailto:almainterior.id@gmail.com" class="block text-white/80 hover:text-white transition-colors">
          almainterior.id@gmail.com
        </a>
        <p class="text-white/80">
          Jakarta, Indonesia
        </p>
      </div>

      <!-- Social Links -->
      <div class="space-y-4">
        <a href="https://www.instagram.com/almainterior.id" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-white/80 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Instagram
        </a>
        <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-white/80 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Facebook
        </a>
        <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-white/80 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          YouTube
        </a>
        <a href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-white/80 hover:text-white transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="max-w-7xl mx-auto px-8 pb-8">
    <div class="border-t border-white/10 pt-8">
      <p class="text-white/30 text-sm text-center">
        © 2025 Alma Interior. All rights reserved.
      </p>
    </div>
  </div>
</section>