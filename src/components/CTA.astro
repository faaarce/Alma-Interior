---
interface Props {
  heading?: string;
  description?: string;
  ctaLabel?: string;
  phoneLabel?: string;
  backgroundImage?: string;
}

const {
  heading = 'Unlock Your Dream<br />Home Today!',
  description = 'We encourage clients to actively participate in discussions, share their ideas, preferences, and feedback.',
  ctaLabel = 'Get In Touch',
  phoneLabel = 'Call Us: +(62) 817-1772-6000',
  backgroundImage = 'https://images.unsplash.com/photo-1506606401543-2e73709cebb4?w=1920&h=800&fit=crop',
} = Astro.props;
---

<section id="contact" class="py-32 bg-[#E8E4DC] relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <img
      src={backgroundImage}
      alt="Interior background"
      class="w-full h-full object-cover opacity-20"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#E8E4DC]/95 via-[#F5F2EB]/90 to-[#E8E4DC]/95" />
  </div>

  <div class="relative max-w-7xl mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-7xl font-bold text-[#3A3A3A] leading-tight font-serif" set:html={heading} />
      </div>
      <div>
        <p class="text-xl text-[#6B6B6B] mb-8 leading-relaxed">{description}</p>
        <div class="flex flex-col sm:flex-row items-start sm:items-center space-y-4 sm:space-y-0 sm:space-x-4">
          <button class="bg-gradient-to-r from-[#D4AF37] to-[#C5A572] hover:from-[#C5A572] hover:to-[#D4AF37] text-white px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg shadow-xl">
            <span>{ctaLabel}</span>
            <span>↗</span>
          </button>
          <button class="border-2 border-[#C5A572] hover:border-[#D4AF37] backdrop-blur-sm text-[#3A3A3A] px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 flex items-center space-x-2 text-lg hover:bg-white/50">
            <span>{phoneLabel}</span>
            <span>↗</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Decorative Elements -->
  <div class="absolute top-20 right-20 w-32 h-32 opacity-5">
    <svg viewBox="0 0 24 24" class="w-full h-full text-[#D4AF37]" fill="currentColor">
      <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
    </svg>
  </div>
  <div class="absolute bottom-20 left-20 w-24 h-24 opacity-5">
    <svg viewBox="0 0 24 24" class="w-full h-full text-[#C5A572]" fill="currentColor">
      <circle cx="12" cy="12" r="10" />
    </svg>
  </div>
</section>