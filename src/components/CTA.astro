---
interface Props {
  heading?: string;
  ctaLabel?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  heading = 'Ready To Build Your<br />Dream Project?',
  ctaLabel = 'Get Started',
  whatsappNumber = '6281717726000',
  whatsappMessage = 'Halo Alma Interior, saya mau konsultasi interior. Mohon info ya, terima kasih',
} = Astro.props;

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section id="contact" class="bg-gradient-to-br from-[#2C2C2C] via-[#1C1C1C] to-[#2C2C2C] overflow-hidden">
  <!-- CTA + Links -->
  <div class="max-w-7xl mx-auto px-8 pt-24 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
      <!-- Left: Heading + Button -->
      <div>
        <h2 class="text-6xl font-bold text-white leading-tight mb-10 font-serif cta-reveal cta-heading" set:html={heading} />
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-reveal cta-btn inline-flex items-center space-x-2 bg-[#E8E4DC] text-[#1C1C1C] px-8 py-4 rounded-full transition-all duration-300 hover:scale-105 hover:bg-white text-lg font-medium shadow-xl hover:shadow-[#D4AF37]/20 hover:shadow-2xl"
          style="transition-delay: 0.2s;"
        >
          <span>{ctaLabel}</span>
          <span class="cta-arrow">↗</span>
        </a>
      </div>

      <!-- Right: Quick Links + Legal Links -->
      <div class="grid grid-cols-2 gap-12">
        <div class="cta-reveal" style="transition-delay: 0.3s;">
          <p class="text-[#C5A572] font-semibold mb-6">Quick Links</p>
          <nav class="space-y-4">
            <a href="#projects" class="cta-link block text-white/80 hover:text-white transition-all duration-300">Projects</a>
            <a href="#about" class="cta-link block text-white/80 hover:text-white transition-all duration-300">About Us</a>
            <a href="#contact" class="cta-link block text-white/80 hover:text-white transition-all duration-300">Contact</a>
            <a href="#" class="cta-link block text-white/80 hover:text-white transition-all duration-300">Career</a>
          </nav>
        </div>
        <div class="cta-reveal" style="transition-delay: 0.45s;">
          <p class="text-[#C5A572] font-semibold mb-6">Legal & Policy Links</p>
          <nav class="space-y-4">
            <a href="#" class="cta-link block text-white/80 hover:text-white transition-all duration-300">Privacy Policy</a>
            <a href="#" class="cta-link block text-white/80 hover:text-white transition-all duration-300">Terms of Service</a>
            <a href="#contact" class="cta-link block text-white/80 hover:text-white transition-all duration-300">Contact Us</a>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-8">
    <div class="cta-divider border-t border-white/10"></div>
  </div>

  <!-- Footer -->
  <div class="max-w-7xl mx-auto px-8 pt-16 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Logo + Tagline -->
      <div class="cta-reveal" style="transition-delay: 0.1s;">
        <div class="flex items-center gap-3 mb-6">
          <div class="cta-logo-spin w-10 h-10 bg-gradient-to-br from-[#D4AF37] to-[#C5A572] rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z" />
            </svg>
          </div>
          <span class="text-2xl font-bold text-white tracking-wider">ALMA INTERIOR</span>
        </div>
        <p class="text-white/50 leading-relaxed">
          Interior Design & Custom Furniture dengan desain modern dan rapi sesuai kebutuhan anda.
        </p>
      </div>

      <!-- Contact Info -->
      <div class="cta-reveal" style="transition-delay: 0.25s;">
        <div class="space-y-4">
          <a href="https://wa.me/6281717726000" target="_blank" rel="noopener noreferrer" class="cta-link block text-white/80 hover:text-white transition-all duration-300">
            +62 817-1772-6000
          </a>
          <a href="mailto:almainterior.id@gmail.com" class="cta-link block text-white/80 hover:text-white transition-all duration-300">
            almainterior.id@gmail.com
          </a>
          <p class="text-white/80">
            Jakarta, Indonesia
          </p>
        </div>
      </div>

      <!-- Social Links -->
      <div class="cta-reveal" style="transition-delay: 0.4s;">
        <div class="space-y-4">
          <a href="https://www.instagram.com/almainterior.id" target="_blank" rel="noopener noreferrer" class="cta-social flex items-center gap-3 text-white/80 hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Instagram
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" class="cta-social flex items-center gap-3 text-white/80 hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </a>
          <a href="https://youtu.be/YPndRSoPQwA" target="_blank" rel="noopener noreferrer" class="cta-social flex items-center gap-3 text-white/80 hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            YouTube
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" class="cta-social flex items-center gap-3 text-white/80 hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="max-w-7xl mx-auto px-8 pb-8">
    <div class="cta-divider border-t border-white/10 pt-8">
      <p class="text-white/30 text-sm text-center cta-reveal" style="transition-delay: 0.5s;">
        © 2025 Alma Interior. All rights reserved.
      </p>
    </div>
  </div>
</section>

<style>
  /* Fade up reveal */
  .cta-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .cta-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Heading letter-spacing animation */
  .cta-heading {
    letter-spacing: 0.05em;
    transition: opacity 0.8s ease-out, transform 0.8s ease-out, letter-spacing 1.2s ease-out;
  }
  .cta-heading.visible {
    letter-spacing: -0.02em;
  }

  /* Button pulse glow */
  .cta-btn {
    position: relative;
  }
  .cta-btn.visible {
    animation: btn-glow 2s ease-in-out 1s 1;
  }
  @keyframes btn-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
    50% { box-shadow: 0 0 30px 8px rgba(212, 175, 55, 0.3); }
  }

  /* Arrow bounce on hover */
  .cta-arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }
  .cta-btn:hover .cta-arrow {
    transform: translate(3px, -3px);
  }

  /* Link hover slide */
  .cta-link {
    position: relative;
    padding-left: 0;
    transition: padding-left 0.3s ease, color 0.3s ease;
  }
  .cta-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0;
    height: 1px;
    background: #C5A572;
    transition: width 0.3s ease;
    transform: translateY(-50%);
  }
  .cta-link:hover {
    padding-left: 20px;
  }
  .cta-link:hover::before {
    width: 14px;
  }

  /* Social icons scale + glow */
  .cta-social svg {
    transition: transform 0.3s ease, filter 0.3s ease;
  }
  .cta-social:hover svg {
    transform: scale(1.2);
    filter: drop-shadow(0 0 6px rgba(197, 165, 114, 0.5));
  }

  /* Logo spin on reveal */
  .cta-logo-spin {
    transition: transform 0.8s ease-out;
  }
  .visible .cta-logo-spin {
    animation: logo-spin 0.8s ease-out 0.3s 1;
  }
  @keyframes logo-spin {
    0% { transform: rotate(0deg) scale(0.5); }
    60% { transform: rotate(380deg) scale(1.1); }
    100% { transform: rotate(360deg) scale(1); }
  }

  /* Divider grow */
  .cta-divider {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s ease-out;
  }
  .cta-divider.visible {
    transform: scaleX(1);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('#contact .cta-reveal, #contact .cta-divider').forEach((el) => observer.observe(el));
</script>