---
interface Props {
  sectionLabel?: string;
  heading?: string;
  description?: string;
  youtubeUrl?: string;
}

const {
  sectionLabel = 'TESTIMONIAL',
  heading = 'Hear From<br />Our Clients',
  description = 'Dengarkan langsung pengalaman klien kami yang telah mempercayakan proyek interior mereka kepada Alma Interior.',
  youtubeUrl = 'https://youtu.be/UkwGDniuIbY',
} = Astro.props;

// Extract YouTube ID from various URL formats
function getYouTubeId(url: string): string {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/))([^?&]+)/);
  return match ? match[1] : '';
}

const videoId = getYouTubeId(youtubeUrl);
const embedUrl = `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`;
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
---

<section id="video-testimonial" class="py-24 bg-gradient-to-br from-[#2C2C2C] via-[#1C1C1C] to-[#2C2C2C] relative overflow-hidden">
  <!-- Floating decorative elements -->
  <div class="vt-float absolute top-20 right-16 w-64 h-64 border border-[#C5A572]/5 rounded-full pointer-events-none"></div>
  <div class="vt-float-reverse absolute bottom-20 left-10 w-40 h-40 border border-[#C5A572]/5 rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-8 relative z-10">
    <!-- Header -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16 items-end">
      <div class="vt-reveal">
        <p class="text-sm text-[#C5A572] font-semibold tracking-wider mb-4 vt-label">{sectionLabel}</p>
        <h2 class="text-6xl font-bold text-white leading-tight font-serif vt-heading" set:html={heading} />
        <div class="vt-line mt-6 h-[2px] w-0 bg-gradient-to-r from-[#C5A572] to-transparent"></div>
      </div>
      <div class="vt-reveal" style="transition-delay: 0.2s;">
        <p class="text-xl text-white/60 leading-relaxed">{description}</p>
      </div>
    </div>

    <!-- Video Player -->
    <div class="vt-video-card relative rounded-3xl overflow-hidden shadow-2xl" style="transition-delay: 0.3s;">
      <!-- Thumbnail with play button (before click) -->
      <div id="vtThumbnail" class="relative aspect-video cursor-pointer group">
        <img
          src={thumbnailUrl}
          alt="Video testimonial thumbnail"
          class="w-full h-full object-cover vt-thumb-zoom"
        />
        <!-- Dark overlay -->
        <div class="absolute inset-0 bg-black/40 group-hover:bg-black/30 transition-colors duration-300"></div>

        <!-- Play button -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="vt-play-btn relative w-20 h-20 md:w-24 md:h-24 bg-[#C5A572] rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-2xl">
            <svg class="w-8 h-8 md:w-10 md:h-10 text-white ml-1" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
            <!-- Pulse ring -->
            <div class="absolute inset-0 rounded-full border-2 border-[#C5A572]/50 vt-pulse-ring"></div>
            <div class="absolute inset-0 rounded-full border-2 border-[#C5A572]/30 vt-pulse-ring" style="animation-delay: 1s;"></div>
          </div>
        </div>

        <!-- Bottom gradient -->
        <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-black/60 to-transparent"></div>

        <!-- Video label -->
        <div class="absolute bottom-6 left-8 flex items-center gap-3">
          <div class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></div>
          <span class="text-white/80 text-sm font-medium">Client Testimonial Video</span>
        </div>
      </div>

      <!-- Embedded iframe (after click) -->
      <div id="vtPlayer" class="hidden aspect-video">
        <iframe
          id="vtIframe"
          class="w-full h-full"
          src=""
          data-src={`${embedUrl}&autoplay=1`}
          title="Client Testimonial"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <!-- Decorative gold corner accents -->
      <div class="absolute top-0 left-0 w-16 h-16 pointer-events-none vt-corner vt-corner-tl">
        <div class="absolute top-0 left-0 w-full h-[2px] bg-[#C5A572]/30"></div>
        <div class="absolute top-0 left-0 w-[2px] h-full bg-[#C5A572]/30"></div>
      </div>
      <div class="absolute bottom-0 right-0 w-16 h-16 pointer-events-none vt-corner vt-corner-br">
        <div class="absolute bottom-0 right-0 w-full h-[2px] bg-[#C5A572]/30"></div>
        <div class="absolute bottom-0 right-0 w-[2px] h-full bg-[#C5A572]/30"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll reveal */
  .vt-reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .vt-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Label tracking */
  .vt-label {
    letter-spacing: 0.4em;
    transition: letter-spacing 1.2s ease-out 0.2s;
  }
  .visible .vt-label {
    letter-spacing: 0.15em;
  }

  /* Heading clip reveal */
  .vt-heading {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1s cubic-bezier(0.77, 0, 0.175, 1) 0.3s;
  }
  .visible .vt-heading {
    clip-path: inset(0 0% 0 0);
  }

  /* Decorative line grow */
  .vt-line {
    transition: width 0.8s ease-out 0.8s;
  }
  .visible .vt-line {
    width: 60%;
  }

  /* Video card reveal */
  .vt-video-card {
    opacity: 0;
    transform: translateY(50px) scale(0.98);
    transition: opacity 0.8s ease-out 0.3s, transform 0.8s ease-out 0.3s;
  }
  .vt-video-card.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  /* Thumbnail slow zoom */
  .vt-thumb-zoom {
    transform: scale(1.05);
    transition: transform 8s ease-out;
  }
  .vt-video-card.visible .vt-thumb-zoom {
    transform: scale(1);
  }
  #vtThumbnail:hover .vt-thumb-zoom {
    transform: scale(1.08) !important;
    transition: transform 0.7s ease !important;
  }

  /* Play button entrance */
  .vt-play-btn {
    animation: vt-play-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s both;
  }
  @keyframes vt-play-pop {
    0% { transform: scale(0); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Pulse rings */
  .vt-pulse-ring {
    animation: vt-pulse 2s ease-out infinite;
  }
  @keyframes vt-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* Corner accents */
  .vt-corner {
    opacity: 0;
    transition: opacity 0.6s ease-out 0.6s;
  }
  .vt-video-card.visible .vt-corner {
    opacity: 1;
  }
  .vt-corner-tl div:first-child {
    transform-origin: left;
    animation: vt-corner-h 0.6s ease-out 1s both;
  }
  .vt-corner-tl div:last-child {
    transform-origin: top;
    animation: vt-corner-v 0.6s ease-out 1.1s both;
  }
  .vt-corner-br div:first-child {
    transform-origin: right;
    animation: vt-corner-h 0.6s ease-out 1s both;
  }
  .vt-corner-br div:last-child {
    transform-origin: bottom;
    animation: vt-corner-v 0.6s ease-out 1.1s both;
  }
  @keyframes vt-corner-h {
    0% { transform: scaleX(0); }
    100% { transform: scaleX(1); }
  }
  @keyframes vt-corner-v {
    0% { transform: scaleY(0); }
    100% { transform: scaleY(1); }
  }

  /* Floating decorative shapes */
  .vt-float {
    animation: vt-drift 16s ease-in-out infinite;
  }
  .vt-float-reverse {
    animation: vt-drift-reverse 12s ease-in-out infinite;
  }
  @keyframes vt-drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-15px, 20px) scale(1.05); }
    66% { transform: translate(10px, -15px) scale(0.95); }
  }
  @keyframes vt-drift-reverse {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(20px, -15px) scale(0.95); }
    66% { transform: translate(-10px, 10px) scale(1.05); }
  }
</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.15 }
  );

  document.querySelectorAll('#video-testimonial .vt-reveal, #video-testimonial .vt-video-card').forEach((el) => observer.observe(el));

  // Click-to-play: swap thumbnail for iframe
  const thumbnail = document.getElementById('vtThumbnail');
  const player = document.getElementById('vtPlayer');
  const iframe = document.getElementById('vtIframe') as HTMLIFrameElement | null;

  thumbnail?.addEventListener('click', () => {
    if (!player || !iframe) return;
    iframe.src = iframe.dataset.src || '';
    thumbnail.classList.add('hidden');
    player.classList.remove('hidden');
  });
</script>